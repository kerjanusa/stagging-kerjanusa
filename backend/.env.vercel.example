# Backend Vercel environment
#
# Isi nilai-nilai ini di Vercel project BACKEND.
# Jangan commit file .env asli yang berisi password/token.

APP_NAME="KerjaNusa"
APP_ENV=production
APP_KEY=base64:GENERATE_DENGAN_php_artisan_key_generate_show
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://stagging-kerjanusa-backend.vercel.app
FRONTEND_APP_URL=https://stagging-kerjanusa-frontend.vercel.app

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://stagging-kerjanusa-backend.vercel.app/api/oauth/google/callback
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=https://stagging-kerjanusa-backend.vercel.app/api/oauth/facebook/callback
OAUTH_STATE_TTL_SECONDS=600

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_SERVICE_LEVEL=info
LOG_SERVICE_DAYS=14

CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array

# Recommended untuk Vercel: pakai database eksternal seperti Supabase Postgres.
DB_CONNECTION=pgsql
DB_SSLMODE=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Upload file production wajib pakai storage durable.
# Bisa diisi dengan Supabase Storage S3-compatible, Cloudflare R2, atau S3.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Izinkan frontend memanggil API backend.
CORS_ALLOWED_ORIGINS=https://stagging-kerjanusa-frontend.vercel.app
SANCTUM_STATEFUL_DOMAINS=stagging-kerjanusa-frontend.vercel.app

# Email reset password. Untuk staging awal bisa pakai log/fallback dulu.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@kerjanusa.com"
MAIL_FROM_NAME="${APP_NAME}"
PASSWORD_RESET_TRANSPORT=mail
PASSWORD_RESET_LOG_FALLBACK=true
PASSWORD_RESET_EXPOSE_LINK=false

# Jika nanti pakai Brevo untuk email sungguhan, isi ini lalu set
# PASSWORD_RESET_TRANSPORT=brevo_api.
BREVO_API_KEY=
BREVO_API_ENDPOINT=https://api.brevo.com/v3/smtp/email
BREVO_API_TIMEOUT=15
