# Frontend Vercel environment
#
# Isi nilai ini di Vercel project FRONTEND.
# Ganti domain backend setelah project backend Vercel selesai dibuat.
VITE_API_URL=https://stagging-kerjanusa-backend.vercel.app/api
VITE_SHOW_RESET_DEBUG_LINK=false
VITE_ENABLE_OAUTH_LOGIN=false
# Isi contoh: google,facebook hanya setelah backend OAuth provider sudah dikonfigurasi.
VITE_OAUTH_PROVIDERS=
